{
  "item": [
    {
      "id": "6c68b6fa-3b40-4561-8c96-8955caedfbcf",
      "name": "Authorization",
      "description": {
        "content": "The Workstream API uses OAuth 2.0 Bearer access tokens to authenticate requests. You can view and manage your access tokens in the [Workstream Dashboard](https://hr.workstream.us/#/company?currentPanel=integrations&integrationItem=accesstoken).\n\nTo generate an access token, simply click on `Generate token`, give it a name, and select the permissions(i.e. Applicants, Employees, Positions) to attach to it. **The token expires in 7 days.**\n\nYou can also manage your tokens through API, as shown in the next section.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "08891eb6-771c-4b54-b90d-a0480965a4cd",
          "name": "Create a new access token",
          "request": {
            "name": "Create a new access token",
            "description": {
              "content": "Creates a new access token.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) Grant type of access token, please use `client_credentials`."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) Client credentials provided as part of your application. This can be retrieved from the Dashboard under `Company->Integrations->Access Tokens`."
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "(Required) The password used to authenticate your application. This can be retrieved from the Dashboard under `Company->Integrations->Access Tokens`."
                },
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "(Required) Name of the access token displayed in the Dashboard."
                },
                {
                  "disabled": false,
                  "key": "scopes",
                  "value": "<string>%20<string>",
                  "description": "(Required) Permission scopes of access token."
                }
              ],
              "variable": [
                {
